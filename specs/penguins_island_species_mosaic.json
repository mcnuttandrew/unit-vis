{
  "$schema": "https://unit-vis.netlify.com/assets/unit-vis-schema.json",
  "title": "Penguin species by island",
  "data": { "url": "data/penguins.csv" },
  "width": 640,
  "height": 480,
  "padding": { "top": 5, "left": 5, "bottom": 5, "right": 5 },
  "layouts": [
    {
      "name": "island",
      "type": "gridxy",
      "subgroup": { "type": "groupby", "key": "island", "isShared": false },
      "aspect_ratio": "fillX",
      "size": { "type": "count", "isShared": true },
      "direction": "LRBT",
      "align": "LB",
      "margin": { "top": 2, "left": 2, "bottom": 2, "right": 2 },
      "padding": { "top": 2, "left": 2, "bottom": 2, "right": 2 },
      "box": {
        "fill": "none",
        "stroke": "black",
        "stroke-width": 1,
        "opacity": 0.4
      }
    },
    {
      "name": "species",
      "type": "gridxy",
      "subgroup": { "type": "groupby", "key": "species", "isShared": true },
      "aspect_ratio": "fillY",
      "size": { "type": "count", "isShared": false },
      "direction": "BTLR",
      "align": "LB",
      "margin": { "top": 2, "left": 2, "bottom": 2, "right": 2 },
      "padding": { "top": 2, "left": 2, "bottom": 2, "right": 2 },
      "box": {
        "fill": "none",
        "stroke": "black",
        "stroke-width": 0.5,
        "opacity": 0.3
      }
    },
    {
      "name": "penguins",
      "type": "gridxy",
      "subgroup": { "type": "flatten" },
      "aspect_ratio": "maxfill",
      "size": { "type": "uniform", "isShared": false },
      "direction": "LRTB",
      "align": "LT",
      "margin": { "top": 0, "left": 0, "bottom": 0, "right": 0 },
      "padding": { "top": 0, "left": 0, "bottom": 0, "right": 0 },
      "sort": { "key": "sex", "type": "categorical", "direction": "ascending" }
    }
  ],
  "mark": {
    "shape": "rect",
    "color": {
      "key": "species",
      "type": "categorical",
      "scheme": "schemeAccent"
    },
    "size": { "type": "max", "isShared": false },
    "isColorScaleShared": true
  },
  "labels": true,
  "legend": true
}
