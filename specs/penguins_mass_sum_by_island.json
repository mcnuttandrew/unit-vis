{
  "$schema": "https://unit-vis.netlify.com/assets/unit-vis-schema.json",
  "title"  : "Total penguin mass by island",
  "data"   : {"url": "data/penguins.csv"},
  "width"  : 600,
  "height" : 400,
  "padding": {"top": 10, "left": 10, "bottom": 10, "right": 10},
  "layouts": [
    {
      "name"        : "island",
      "type"        : "gridxy",
      "subgroup"    : {"type": "groupby", "key": "island", "isShared": false},
      "aspect_ratio": "fillX",
      "size"        : {"type": "uniform", "isShared": true},
      "direction"   : "LRBT",
      "align"       : "LB",
      "margin"      : {"top": 5, "left": 5, "bottom": 5, "right": 5},
      "padding"     : {"top": 5, "left": 5, "bottom": 5, "right": 5},
      "box"         : {"fill": "white", "stroke": "black", "stroke-width": 0.5, "opacity": 0.3},
      "sort"        : {"key": "island", "type": "categorical", "direction": "ascending"}
    },
    {
      "name"        : "mass",
      "type"        : "gridxy",
      "subgroup"    : {"type": "passthrough", "isShared": true},
      "aspect_ratio": "fillY",
      "size"        : {"type": "sum", "key": "body_mass_g", "isShared": true},
      "direction"   : "BT",
      "align"       : "bottom",
      "margin"      : {"top": 0, "left": 0, "bottom": 0, "right": 0},
      "padding"     : {"top": 0, "left": 0, "bottom": 0, "right": 0},
      "box"         : {"fill": "white", "stroke": "black", "stroke-width": 0.5, "opacity": 0.4}
    },
    {
      "name"        : "penguins",
      "type"        : "gridxy",
      "subgroup"    : {"type": "flatten"},
      "aspect_ratio": "maxfill",
      "size"        : {"type": "uniform", "isShared": true},
      "direction"   : "LRBT",
      "align"       : "LB",
      "margin"      : {"top": 0, "left": 0, "bottom": 0, "right": 0},
      "padding"     : {"top": 0, "left": 0, "bottom": 0, "right": 0},
      "sort"        : {"key": "body_mass_g", "type": "numerical", "direction": "ascending"}
    }
  ],
  "mark"   : {
    "shape"             : "rect",
    "color"             : {"key": "species", "type": "categorical"},
    "size"              : {"type": "max", "isShared": false},
    "isColorScaleShared": true
  },
  "labels" : false,
  "legend" : true
}
