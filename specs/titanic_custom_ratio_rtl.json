{
  "$schema": "https://unit-vis.netlify.com/assets/unit-vis-schema.json",
  "title": "Titanic passengers, packed right to left",
  "data": { "url": "data/titanic3.csv" },
  "width": 720,
  "height": 320,
  "padding": { "top": 10, "left": 10, "bottom": 10, "right": 10 },
  "layouts": [
    {
      "name": "class",
      "type": "gridxy",
      "subgroup": { "type": "groupby", "key": "pclass", "isShared": false },
      "aspect_ratio": "fillX",
      "size": { "type": "uniform", "isShared": true },
      "direction": "RL",
      "align": "LB",
      "margin": { "top": 5, "left": 5, "bottom": 5, "right": 5 },
      "padding": { "top": 5, "left": 5, "bottom": 5, "right": 5 },
      "box": {
        "fill": "white",
        "stroke": "black",
        "stroke-width": 0.5,
        "opacity": 0.3
      },
      "sort": {
        "key": "pclass",
        "type": "categorical",
        "direction": "ascending"
      }
    },
    {
      "name": "passengers",
      "type": "gridxy",
      "subgroup": { "type": "flatten" },
      "aspect_ratio": "custom",
      "custom_aspect_ratio": 1.6,
      "size": { "type": "uniform", "isShared": true },
      "direction": "RLTB",
      "align": "LB",
      "margin": { "top": 0, "left": 0, "bottom": 0, "right": 0 },
      "padding": { "top": 0, "left": 0, "bottom": 0, "right": 0 },
      "sort": {
        "key": "survived",
        "type": "categorical",
        "direction": "descending"
      }
    }
  ],
  "mark": {
    "shape": "rect",
    "color": { "key": "survived", "type": "categorical" },
    "size": { "type": "max", "isShared": false },
    "isColorScaleShared": true
  },
  "labels": true,
  "legend": true
}
