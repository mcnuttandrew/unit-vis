{
  "$schema": "https://unit-vis.netlify.com/assets/unit-vis-schema.json",
  "title"  : "Penguins by species and sex",
  "data"   : {"url": "data/penguins.csv"},
  "width"  : 600,
  "height" : 420,
  "padding": {"top": 5, "left": 5, "bottom": 5, "right": 5},
  "layouts": [
    {
      "name"        : "species",
      "type"        : "gridxy",
      "subgroup"    : {"type": "groupby", "key": "species", "isShared": false},
      "aspect_ratio": "fillX",
      "size"        : {"type": "uniform", "isShared": true},
      "direction"   : "LRBT",
      "align"       : "LB",
      "margin"      : {"top": 4, "left": 4, "bottom": 4, "right": 4},
      "padding"     : {"top": 4, "left": 4, "bottom": 4, "right": 4},
      "box"         : {"fill": "none", "stroke": "black", "stroke-width": 1, "opacity": 0.4}
    },
    {
      "name"        : "sex",
      "type"        : "gridxy",
      "subgroup"    : {"type": "groupby", "key": "sex", "isShared": true},
      "aspect_ratio": "fillY",
      "size"        : {"type": "uniform", "isShared": true},
      "direction"   : "BTLR",
      "align"       : "LB",
      "margin"      : {"top": 3, "left": 3, "bottom": 3, "right": 3},
      "padding"     : {"top": 3, "left": 3, "bottom": 3, "right": 3},
      "box"         : {"fill": "none", "stroke": "gray", "stroke-width": 0.5, "opacity": 0.5}
    },
    {
      "name"        : "penguins",
      "type"        : "gridxy",
      "subgroup"    : {"type": "flatten"},
      "aspect_ratio": "maxfill",
      "size"        : {"type": "uniform", "isShared": true},
      "direction"   : "LRTB",
      "align"       : "LT",
      "margin"      : {"top": 0, "left": 0, "bottom": 0, "right": 0},
      "padding"     : {"top": 0, "left": 0, "bottom": 0, "right": 0},
      "sort"        : {"key": "island", "type": "categorical", "direction": "ascending"}
    }
  ],
  "mark"   : {
    "shape"             : "circle",
    "color"             : {"key": "sex", "type": "categorical", "scheme": "schemeDark2"},
    "size"              : {"type": "max", "isShared": false},
    "isColorScaleShared": true
  }
}
