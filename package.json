{
  "name": "unit-vis-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite apps/playground",
    "build": "npm run build:packages && npm run typecheck && vite build apps/playground",
    "build:packages": "tsc -p packages/core && tsc -p packages/unit-vis && tsc -p packages/unit-vis-vega",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/playground/tsconfig.json",
    "preview": "vite preview apps/playground",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema": "node scripts/generate-schema.mjs",
    "report:svg": "vite-node scripts/svg-report.ts",
    "specs:list": "vite-node scripts/regenerate-spec-list.ts",
    "specs:compress": "vite-node scripts/compress-specs.ts",
    "specs:json": "vite-node scripts/specs-to-json.ts",
    "data:sync": "vite-node scripts/sync-datasets.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-color": "^3.1.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "d3-color": "^3.1.0",
    "fracturedjsonjs": "^5.0.1",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "json-schema-library": "^9.3.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "typescript-json-schema": "^0.68.0",
    "vite": "^8.2.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
