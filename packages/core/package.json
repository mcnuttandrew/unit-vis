{
  "name": "@unit-vis/core",
  "version": "0.1.0",
  "description": "The unit-vis grammar and layout engine, with no renderer and no dependencies",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
