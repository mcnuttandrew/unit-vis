{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `fetch` is the only browser api the engine touches, and it is what keeps
    // data loading dependency-free.
    "lib": ["ES2023", "DOM"],

    // Relative imports inside the packages carry their `.js` extension, so what
    // tsc emits is resolvable by node as well as by a bundler.
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src"]
}
