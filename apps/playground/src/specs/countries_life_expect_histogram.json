{
  "$schema": "https://unit-vis.netlify.com/assets/unit-vis-schema.json",
  "title"  : "Life expectancy, 1955-2000",
  "data"   : {"url": "data/countries.json"},
  "width"  : 720,
  "height" : 400,
  "padding": {"top": 10, "left": 10, "bottom": 10, "right": 10},
  "layouts": [
    {
      "name"        : "life_bin",
      "type"        : "gridxy",
      "subgroup"    : {"type": "bin", "key": "life_expect", "numBin": 14, "isShared": false},
      "aspect_ratio": "fillX",
      "size"        : {"type": "uniform", "isShared": true},
      "direction"   : "LRBT",
      "align"       : "LB",
      "margin"      : {"top": 2, "left": 2, "bottom": 2, "right": 2},
      "padding"     : {"top": 2, "left": 2, "bottom": 2, "right": 2},
      "box"         : {"fill": "white", "stroke": "black", "stroke-width": 0.5, "opacity": 0.3},
      "sort"        : {"key": "life_expect", "type": "numerical", "direction": "ascending"}
    },
    {
      "name"        : "stack",
      "type"        : "gridxy",
      "subgroup"    : {"type": "passthrough", "isShared": true},
      "aspect_ratio": "fillY",
      "size"        : {"type": "count", "isShared": true},
      "direction"   : "BT",
      "align"       : "bottom",
      "margin"      : {"top": 0, "left": 0, "bottom": 0, "right": 0},
      "padding"     : {"top": 0, "left": 0, "bottom": 0, "right": 0},
      "box"         : {"fill": "none", "stroke": "gray", "stroke-width": 0, "opacity": 0.2}
    },
    {
      "name"        : "observations",
      "type"        : "gridxy",
      "subgroup"    : {"type": "flatten"},
      "aspect_ratio": "maxfill",
      "size"        : {"type": "uniform", "isShared": false},
      "direction"   : "BTLR",
      "align"       : "LB",
      "margin"      : {"top": 0, "left": 0, "bottom": 0, "right": 0},
      "padding"     : {"top": 0, "left": 0, "bottom": 0, "right": 0},
      "sort"        : {"key": "year", "type": "numerical", "direction": "ascending"}
    }
  ],
  "mark"   : {
    "shape"             : "rect",
    "color"             : {"key": "year", "type": "categorical", "scheme": "schemePaired"},
    "size"              : {"type": "max", "isShared": false},
    "isColorScaleShared": true
  },
  "labels" : false,
  "legend" : true
}
