{
  "$schema": "https://unit-vis.netlify.com/assets/unit-vis-schema.json",
  "title"  : "Bill length vs bill depth",
  "data"   : {"url": "data/penguins.csv"},
  "width"  : 640,
  "height" : 480,
  "padding": {"top": 5, "left": 5, "bottom": 5, "right": 5},
  "layouts": [
    {
      "name"        : "bill_length_bin",
      "type"        : "gridxy",
      "subgroup"    : {"type": "bin", "key": "bill_length_mm", "numBin": 10, "isShared": false},
      "aspect_ratio": "fillX",
      "size"        : {"type": "uniform", "isShared": true},
      "direction"   : "LRBT",
      "align"       : "LB",
      "margin"      : {"top": 1, "left": 1, "bottom": 1, "right": 1},
      "padding"     : {"top": 1, "left": 1, "bottom": 1, "right": 1},
      "box"         : {"fill": "white", "stroke": "black", "stroke-width": 0.5, "opacity": 0.2},
      "sort"        : {"key": "bill_length_mm", "type": "numerical", "direction": "ascending"}
    },
    {
      "name"        : "bill_depth_bin",
      "type"        : "gridxy",
      "subgroup"    : {"type": "bin", "key": "bill_depth_mm", "numBin": 10, "isShared": true},
      "aspect_ratio": "fillY",
      "size"        : {"type": "uniform", "isShared": true},
      "direction"   : "BT",
      "align"       : "bottom",
      "margin"      : {"top": 1, "left": 1, "bottom": 1, "right": 1},
      "padding"     : {"top": 1, "left": 1, "bottom": 1, "right": 1},
      "box"         : {"fill": "white", "stroke": "gray", "stroke-width": 0.5, "opacity": 0.2},
      "sort"        : {"key": "bill_depth_mm", "type": "numerical", "direction": "ascending"}
    },
    {
      "name"        : "penguins",
      "type"        : "gridxy",
      "subgroup"    : {"type": "flatten"},
      "aspect_ratio": "maxfill",
      "size"        : {"type": "uniform", "isShared": false},
      "direction"   : "LRBT",
      "align"       : "LB",
      "margin"      : {"top": 0, "left": 0, "bottom": 0, "right": 0},
      "padding"     : {"top": 0, "left": 0, "bottom": 0, "right": 0},
      "sort"        : {"key": "species", "type": "categorical", "direction": "ascending"}
    }
  ],
  "mark"   : {
    "shape"             : "circle",
    "color"             : {"key": "species", "type": "categorical", "scheme": "schemeSet1"},
    "size"              : {"type": "max", "isShared": false},
    "isColorScaleShared": true
  },
  "labels" : false,
  "legend" : true
}
